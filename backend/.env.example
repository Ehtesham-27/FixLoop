# Server Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection (Local Community Server or MongoDB Atlas URI)
# For Atlas: mongodb+srv://<db-user>:<db-password>@<cluster-host>/fixloop?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fixloop

# Frontend Origin for CORS Whitelist
# Development:  http://localhost:5173
# Production:   https://your-fixloop.vercel.app   (exact Vercel deployment URL, no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# JWT Secrets (replace with long, secure random secrets in development & production)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_32chars_min
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_32chars_min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# -----------------------------------------------------------------------
# Cloudinary — Persistent Image Storage (REQUIRED in production on Render)
# -----------------------------------------------------------------------
# Render's filesystem is ephemeral; images stored on disk are lost on every
# deployment or restart. Cloudinary provides persistent cloud object storage.
#
# 1. Create a free account at https://cloudinary.com/
# 2. Copy Cloud Name, API Key, and API Secret from your Cloudinary dashboard.
# 3. Add these three variables to your Render environment variable panel.
# 4. Leave blank in local development to fall back to local disk storage.
#
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------
# Cookie / Session Notes
# -----------------------------------------------------------------------
# NODE_ENV=production automatically applies:
#   - Cookie: Secure=true  (HTTPS-only)
#   - Cookie: SameSite=None  (required for cross-origin Vercel → Render requests)
# SameSite=None removes same-site CSRF protection. This is safe here because:
#   - All state-changing requests use stateless JWT bearer tokens, not cookies.
#   - The refresh endpoint only rotates the token pair; it does not mutate app state.
#   - The Secure flag ensures the cookie is never sent over plain HTTP.
#   - CORS credentials:true + CLIENT_ORIGIN whitelist blocks unauthorized origins.
#
# Development (NODE_ENV=development) uses SameSite=Lax automatically.

# -----------------------------------------------------------------------
# Optional Initial Account Seeding (leave empty to skip)
# -----------------------------------------------------------------------
# Passwords must be at least 8 characters long.
# Passwords are never stored in plaintext (hashed with bcrypt factor 12).
INITIAL_ADMIN_NAME=Campus Administrator
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

INITIAL_TECH_NAME=Campus Senior Technician
INITIAL_TECH_EMAIL=
INITIAL_TECH_PASSWORD=
