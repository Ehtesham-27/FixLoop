{
  "name": "fixloop-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:interactive": "node src/scripts/seed.js --interactive",
    "test:db": "node tests/db.test.js",
    "test:auth": "node tests/auth.test.js",
    "test:tickets": "node tests/ticket.test.js",
    "test:upload": "node tests/upload.test.js",
    "test:e2e": "node tests/e2e.test.js",
    "test:cloudinary": "node tests/cloudinary.test.js",
    "test": "node tests/db.test.js && node tests/auth.test.js && node tests/ticket.test.js && node tests/upload.test.js && node tests/e2e.test.js && node tests/cloudinary.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
