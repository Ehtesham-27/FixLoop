{
  "name": "fixloop-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "FixLoop: A Responsive Campus Maintenance and Issue Management System",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "typecheck:frontend": "npm run typecheck --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "check:backend": "npm run check --prefix backend",
    "seed:backend": "npm run seed --prefix backend",
    "seed:backend:interactive": "npm run seed:interactive --prefix backend",
    "test:db": "npm run test:db --prefix backend",
    "test:auth": "npm run test:auth --prefix backend",
    "test:tickets": "npm run test:tickets --prefix backend",
    "test:upload": "npm run test:upload --prefix backend",
    "test:e2e": "npm run test:e2e --prefix backend",
    "test:cloudinary": "npm run test:cloudinary --prefix backend",
    "test:admin-tech": "npm run test:admin-tech --prefix backend",
    "test:sla": "npm run test:sla --prefix backend",
    "test": "npm test --prefix backend",
    "typecheck": "npm run typecheck --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "build": "npm run build --prefix frontend"
  },
  "allowScripts": {
    "esbuild": true
  },
  "keywords": [
    "campus-maintenance",
    "issue-tracking",
    "fullstack",
    "mern"
  ],
  "engines": {
    "node": "22.x",
    "npm": ">=10.0.0"
  },
  "author": "",
  "license": "ISC"
}
