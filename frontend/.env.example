# FixLoop Frontend Environment Configuration

# Production on Vercel (using Vercel rewrites in vercel.json to proxy to Render):
VITE_API_BASE_URL=/api

# Local development (proxied by Vite dev server to http://localhost:5001):
# VITE_API_BASE_URL=/api

# Direct backend connection (alternative without Vercel reverse proxy):
# VITE_API_BASE_URL=https://fixloop.onrender.com/api
